{
  "manifest_version": 3,
  "name": "Deezer Collection",
  "version": "1.0.0",
  "description": "Ajoute le titre en cours à la dernière playlist « Collection N » s'il n'est dans aucune de vos collections.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Deezer Collection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": ["https://www.deezer.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.deezer.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
